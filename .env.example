# =============================================================================
# GQM API — Environment Variables Template
# Copy this file to .env and fill in all values before running the app.
# The app will refuse to start if PUBLIC_URL is missing or invalid.
# =============================================================================


# =============================================================================
# CORE
# =============================================================================

# General Flask secret key (use a long random string in production)
SECRET_KEY=change_me_to_a_random_secret

# Entorno de ejecución: "test" o "production"
# - test: usa las apps TAP (de prueba) para todos los Jobs (QID/PTL/PAR de cualquier año)
# - production: usa las credenciales reales PODIO_{TYPE}{YEAR}_APP_ID / APP_TOKEN
# Default: production (si no se define, el sistema usa las credenciales reales)
APP_ENV=production

# JWT access token signing key (60-minute tokens)
LOGIN_SECRET_KEY=change_me_login_secret

# JWT refresh token signing key (7-day tokens)
REFRESH_SECRET_KEY=change_me_refresh_secret

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/gqm_db

# Publicly accessible base URL of THIS API.
# Used to register Podio webhooks. Must be HTTPS in production.
# Example: https://api.mygqm.com
PUBLIC_URL=https://your-public-api-url.com


# =============================================================================
# CLOUDINARY — File storage
# =============================================================================

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret


# =============================================================================
# QUICKBOOKS ONLINE — OAuth 2.0
# =============================================================================

QBO_CLIENT_ID=your_intuit_client_id
QBO_CLIENT_SECRET=your_intuit_client_secret

# Must match the redirect URI configured in your Intuit developer app
QBO_REDIRECT_URI=https://your-public-api-url.com/callback


# =============================================================================
# PODIO — OAuth Client credentials
# =============================================================================

PODIO_CLIENT_ID=your_podio_client_id
PODIO_CLIENT_SECRET=your_podio_client_secret


# =============================================================================
# PODIO — Static Apps (fixed IDs, no year suffix)
# =============================================================================

# Clients app
PODIO_CLIENTS_APP_ID=
PODIO_CLIENTS_APP_TOKEN=

# Parent Management Company app
PODIO_PAMGMTCO_APP_ID=
PODIO_PAMGMTCO_APP_TOKEN=

# Subcontractors app
PODIO_SUBCONTRACTOR_APP_ID=
PODIO_SUBCONTRACTOR_APP_TOKEN=

# Building Departments app
PODIO_BLDGDEPT_APP_ID=
PODIO_BLDGDEPT_APP_TOKEN=


# =============================================================================
# PODIO — Test/Admin Apps (used for webhook management and admin operations)
# =============================================================================

QID_TAP_APP_ID=
QID_TAP_APP_TOKEN=

PTL_TAP_APP_ID=
PTL_TAP_APP_TOKEN=

PAR_TAP_APP_ID=
PAR_TAP_APP_TOKEN=

CLI_TAP_APP_ID=
CLI_TAP_APP_TOKEN=



# =============================================================================
# PODIO — Dynamic Job Apps (one credential pair per job type × year)
# Job types: QID, PTL, PAR — Years: 2023, 2024, 2025, 2026
# =============================================================================

# QID jobs
PODIO_QID2023_APP_ID=
PODIO_QID2023_APP_TOKEN=

PODIO_QID2024_APP_ID=
PODIO_QID2024_APP_TOKEN=

PODIO_QID2025_APP_ID=
PODIO_QID2025_APP_TOKEN=

PODIO_QID2026_APP_ID=
PODIO_QID2026_APP_TOKEN=

# PTL jobs
PODIO_PTL2023_APP_ID=
PODIO_PTL2023_APP_TOKEN=

PODIO_PTL2024_APP_ID=
PODIO_PTL2024_APP_TOKEN=

PODIO_PTL2025_APP_ID=
PODIO_PTL2025_APP_TOKEN=

PODIO_PTL2026_APP_ID=
PODIO_PTL2026_APP_TOKEN=

# PAR jobs
PODIO_PAR2023_APP_ID=
PODIO_PAR2023_APP_TOKEN=

PODIO_PAR2024_APP_ID=
PODIO_PAR2024_APP_TOKEN=

PODIO_PAR2025_APP_ID=
PODIO_PAR2025_APP_TOKEN=

PODIO_PAR2026_APP_ID=
PODIO_PAR2026_APP_TOKEN=

#================== PERMITIR DOMINIOS DEV-PROD ==========================
ALLOWED_ORIGINS=https://gqm-panel-admin.vercel.app,https://gqm-panel-admin-8sfd.vercel.app
# === Seguridad Fase 1 (B2/B3) ===
SECRET_KEY=
FERNET_KEY=            # Fernet.generate_key() — cifrado de tokens QBO (obligatoria en prod)
PODIO_WEBHOOK_TOKEN=   # token de autenticación de los webhooks Podio
PANEL_BASE_URL=        # p.ej. https://panel.gqmconect.com — links de reset de contraseña

# ============ Interruptores de sincronización desde Podio ============
# PODIO_VACIA_SLOTS — APAGADO POR DEFECTO. Con "true", cuando un slot de técnico
# desaparece del item de Podio se vacían las columnas que Podio gobierna en su
# fila `Order` (Formula, Ptl_hd_materials, Notes, Payment_1..3) y el
# `ChangeOrderFormula` de sus change orders de nivel orden. Nunca borra filas, no
# toca `Adj_formula` (la reescribe el recálculo local) ni `ID_Subcontractor`.
#
# Existe para que DESPLEGAR y MOVER LOS AGREGADOS no sean el mismo acto: mide
# antes con `GET /admin/podio/obsoletos_ordenes?type=QID&year=2025`, que corre en
# `dry_run` y por eso NO pasa por este interruptor, y enciéndelo a la vista de esa
# cifra. Afecta a ~9.300 órdenes de producción.
PODIO_VACIA_SLOTS=false
